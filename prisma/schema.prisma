generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id            String   @id @default(cuid())
  name          String
  website       String?
  description   String?
  sector        String?
  subSector     String?
  geography     String?
  arrEstimate   Float?
  arrGrowth     Float?
  nrrEstimate   Float?
  grossMargin   Float?
  employees     Int?
  founded       Int?
  stage         String?
  status        String   @default("IDENTIFIED")
  priority      String   @default("MEDIUM")
  source        String?
  linkedinUrl   String?
  crunchbaseUrl String?
  totalScore    Float?
  // Thesis fields (populated by user or research)
  totalFundingM Float?   // total funding raised in $M
  isIndependent Boolean?
  hasNoTier1VC  Boolean?
  founderMajority Boolean?
  isPE          Boolean?  @default(false)
  verticalFocus String?  // vertical software focus description
  acv           Float?   // average contract value in $K
  thesisFitScore Float?  // cached thesis fit score (0-100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts     Contact[]
  interactions Interaction[]
  scoreDetails ScoreDetail[]
  notes        Note[]
  companyTags  CompanyTag[]
  feedback     CompanyFeedback[]
}

// Thesis criterion — hard filters and weighted signals
model ThesisCriterion {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // HARD_FILTER | SIGNAL
  dataType    String   // RANGE | BOOLEAN | TEXT
  // For RANGE type — maps to a company field
  companyField String? // e.g. "founded", "employees", "totalFundingM", "arrEstimate"
  minValue    Float?
  maxValue    Float?
  unit        String?  // display unit: "year", "employees", "$M", "$K"
  // For BOOLEAN type — maps to a company boolean field or is assessed manually
  boolField   String?  // e.g. "isIndependent", "hasNoTier1VC", "founderMajority"
  boolTarget  Boolean? // the desired value (true/false)
  // For manual/qualitative signals
  importance  Float    @default(3.0) // 1–5, drives weighting in fit score
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  notes       String?  // rationale / guidance for assessing this criterion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// User feedback on a company — drives the learning system
model CompanyFeedback {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signal    String   // PASS | WATCH | INTERESTED | HIGH_PRIORITY
  notes     String?  // freeform: what specifically resonated or didn't
  source    String?  // where feedback was given: "list" | "detail" | "pipeline"
  createdAt DateTime @default(now())
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  title       String?
  email       String?
  linkedinUrl String?
  isPrimary   Boolean  @default(false)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interactions Interaction[]
}

model Interaction {
  id           String    @id @default(cuid())
  type         String
  direction    String    @default("OUTBOUND")
  subject      String?
  content      String?
  date         DateTime  @default(now())
  followUpDate DateTime?
  followUpDone Boolean   @default(false)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  content   String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ScoreDetail {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id])
  score       Float
  notes       String?
  updatedAt   DateTime  @updatedAt
}

model Criterion {
  id           String        @id @default(cuid())
  name         String
  description  String?
  weight       Float
  minThreshold Float         @default(5.0)
  order        Int           @default(0)
  isActive     Boolean       @default(true)
  scoreDetails ScoreDetail[]
}

model Tag {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String       @default("#6366f1")
  companyTags CompanyTag[]
}

model CompanyTag {
  companyId String
  tagId     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
}

model OutreachTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
