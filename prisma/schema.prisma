generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String   @id @default(cuid())
  name          String
  website       String?
  description   String?
  sector        String?
  subSector     String?
  geography     String?
  arrEstimate   Float?
  arrGrowth     Float?
  nrrEstimate   Float?
  grossMargin   Float?
  employees     Int?
  founded       Int?
  stage         String?
  status        String   @default("IDENTIFIED")
  priority      String   @default("MEDIUM")
  source        String?
  linkedinUrl   String?
  crunchbaseUrl String?
  totalScore    Float?
  // Thesis fields (populated by user or research)
  totalFundingM Float?   // total funding raised in $M
  isIndependent Boolean?
  hasNoTier1VC  Boolean?
  founderMajority Boolean?
  isPE          Boolean?  @default(false)
  verticalFocus String?  // vertical software focus description
  acv           Float?   // average contract value in $K
  thesisFitScore Float?  // cached thesis fit score (0-100)
  productRepScore Float? // cached product reputation score (0-10)
  // AI lead recommendation fields
  recommendationRationale String?  // why this fits the thesis
  recommendedAt           DateTime? // when it was surfaced as a lead
  recommendationScore     Float?   // AI fit score 0-100
  scoreBreakdown          String?  // JSON: [{criterion, score, note, met}]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts     Contact[]
  interactions Interaction[]
  scoreDetails ScoreDetail[]
  notes        Note[]
  companyTags  CompanyTag[]
  feedback         CompanyFeedback[]
  research         CompanyResearch?
  fieldSources     CompanyFieldSource[]
  customValues     CompanyCustomValue[]
  diligenceTasks   DealDiligenceTask[]
  dealTerms        DealTerm[]
  investment       PortfolioInvestment?
  kpiSnapshots     PortfolioKPISnapshot[]
}

// Source attribution for individual company data fields
model CompanyFieldSource {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field       String   // e.g. "arrEstimate", "employees", "arrGrowth"
  sourceLabel String   // e.g. "PitchBook", "LinkedIn", "Crunchbase", "Founder call"
  sourceUrl   String?  // direct link if available
  capturedAt  DateTime @default(now())

  @@unique([companyId, field])
}

// Thesis criterion — hard filters and weighted signals
model ThesisCriterion {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // HARD_FILTER | SIGNAL
  dataType    String   // RANGE | BOOLEAN | TEXT
  // For RANGE type — maps to a company field
  companyField String? // e.g. "founded", "employees", "totalFundingM", "arrEstimate"
  minValue    Float?
  maxValue    Float?
  unit        String?  // display unit: "year", "employees", "$M", "$K"
  // For BOOLEAN type — maps to a company boolean field or is assessed manually
  boolField   String?  // e.g. "isIndependent", "hasNoTier1VC", "founderMajority"
  boolTarget  Boolean? // the desired value (true/false)
  // For manual/qualitative signals
  importance  Float    @default(3.0) // 1–5, drives weighting in fit score
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  notes       String?  // rationale / guidance for assessing this criterion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// User feedback on a company — drives the learning system
model CompanyFeedback {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signal    String   // PASS | WATCH | INTERESTED | HIGH_PRIORITY
  notes     String?  // freeform: what specifically resonated or didn't
  source    String?  // where feedback was given: "list" | "detail" | "pipeline"
  createdAt DateTime @default(now())
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  title       String?
  email       String?
  linkedinUrl String?
  isPrimary   Boolean  @default(false)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interactions Interaction[]
}

model Interaction {
  id           String    @id @default(cuid())
  type         String
  direction    String    @default("OUTBOUND")
  subject      String?
  content      String?
  date         DateTime  @default(now())
  followUpDate DateTime?
  followUpDone Boolean   @default(false)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  content   String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ScoreDetail {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id])
  score       Float
  notes       String?
  updatedAt   DateTime  @updatedAt
}

model Criterion {
  id           String        @id @default(cuid())
  name         String
  description  String?
  weight       Float
  minThreshold Float         @default(5.0)
  order        Int           @default(0)
  isActive     Boolean       @default(true)
  scoreDetails ScoreDetail[]
}

model Tag {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String       @default("#6366f1")
  companyTags CompanyTag[]
}

model CompanyTag {
  companyId String
  tagId     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
}

model OutreachTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Live Deal execution ───────────────────────────────────────────────────────

// Due diligence checklist tasks per deal/company
model DealDiligenceTask {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title      String
  workstream String    // FINANCIAL | LEGAL | COMMERCIAL | TECHNICAL | HR | MANAGEMENT
  status     String    @default("OPEN")  // OPEN | IN_PROGRESS | DONE | BLOCKED
  priority   String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  assignee   String?
  dueDate    DateTime?
  notes      String?
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Key deal terms captured from LOI / term sheet
model DealTerm {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Pre-money Valuation", "Investment Amount"
  value     String?
  notes     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ── Portfolio monitoring ──────────────────────────────────────────────────────

// Investment record — one per invested company
model PortfolioInvestment {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investedAmount   Float?    // $M deployed
  ownershipPct     Float?    // % fully-diluted ownership
  investmentDate   DateTime?
  roundType        String?   // Seed, Series A, etc.
  preMoneyVal      Float?    // pre-money valuation $M
  currentValuation Float?    // latest mark $M
  proRataRights    Boolean   @default(false)
  boardSeat        Boolean   @default(false)
  leadInvestor     Boolean   @default(false)
  coInvestors      String?   // comma-separated
  reserveAmount    Float?    // follow-on reserve $M
  moic             Float?    // current MOIC
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Monthly/quarterly KPI snapshots per portfolio company
model PortfolioKPISnapshot {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      String   // "2024-Q1", "2024-Q2" …
  arr         Float?   // $M
  arrGrowth   Float?   // YoY %
  nrr         Float?   // %
  grossMargin Float?   // %
  employees   Int?
  burn        Float?   // monthly $M
  runway      Int?     // months
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([companyId, period])
}

// ── LP Communications ─────────────────────────────────────────────────────────

model LPContact {
  id          String   @id @default(cuid())
  name        String
  firm        String?
  email       String?
  phone       String?
  commitment  Float?   // capital committed $M
  type        String   @default("LP") // LP | CO_INVESTOR | ADVISOR
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LPUpdate {
  id        String    @id @default(cuid())
  period    String    // e.g. "Q1 2025"
  title     String
  body      String    // markdown / freeform
  status    String    @default("DRAFT") // DRAFT | SENT
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── Custom fields (already defined above) ────────────────────────────────────

model CustomFieldDef {
  id          String   @id @default(cuid())
  name        String   // e.g. "EBITDA", "CAC Payback"
  fieldType   String   @default("TEXT") // TEXT | NUMBER | BOOLEAN | URL
  isGlobal    Boolean  @default(false)  // true = shown on all companies
  companyId   String?  // set only when isGlobal=false (company-specific)
  unit        String?  // e.g. "$M", "%", "months"
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  values      CompanyCustomValue[]
}

// Values for custom fields, keyed per company
model CompanyCustomValue {
  id        String          @id @default(cuid())
  fieldId   String
  field     CustomFieldDef  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  value     String?         // stored as string, cast by fieldType on read
  updatedAt DateTime        @updatedAt

  @@unique([fieldId, companyId])
}

// ── Valuation Comparables ─────────────────────────────────────────────────────

model Comp {
  id          String    @id @default(cuid())
  companyName String
  industry    String?
  buyer       String?
  dealDate    DateTime?
  tev         Float?    // Total Enterprise Value $M
  arr         Float?    // ARR $M
  revenue     Float?    // Revenue $M
  grossMargin Float?    // GM %
  yoyGrowth   Float?    // YoY Growth %
  ebitda      Float?    // EBITDA $M
  gdr         Float?    // Gross Dollar Retention %
  ndr         Float?    // Net Dollar Retention %
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Aggregated research data from external sources for a company
model CompanyResearch {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ── Review platforms ─────────────────────────────────────────────────────
  // G2
  g2Url          String?
  g2Rating       Float?   // 0–5
  g2ReviewCount  Int?
  g2Category     String?  // category they appear under on G2
  g2Momentum     String?  // Leader / High Performer / Momentum Leader etc.
  // Capterra
  capterraUrl         String?
  capterraRating      Float?
  capterraReviewCount Int?
  // Gartner Peer Insights
  gartnerUrl         String?
  gartnerRating      Float?
  gartnerReviewCount Int?
  // Trustpilot / other
  trustpilotUrl       String?
  trustpilotRating    Float?
  trustpilotReviewCount Int?

  // ── Web traffic (SimilarWeb, etc.) ───────────────────────────────────────
  similarwebUrl   String?
  monthlyVisits   Int?     // estimated monthly unique visits
  trafficTrend    String?  // UP | DOWN | STABLE
  globalRank      Int?
  trafficSources  String?  // JSON: {direct, search, social, referral, …}

  // ── Funding / investor intelligence ──────────────────────────────────────
  // Crunchbase
  crunchbaseSlug      String?
  lastFundingType     String?  // Seed, Series A, etc.
  lastFundingAmount   Float?   // $M
  lastFundingDate     String?
  keyInvestors        String?  // comma-separated list
  // PitchBook
  pitchbookUrl   String?
  // Harmonic
  harmonicUrl    String?
  // Grata
  grataUrl       String?
  // SourceScrub
  sourcescrubUrl String?

  // ── Market positioning ────────────────────────────────────────────────────
  gartnerMQUrl   String?  // Gartner Magic Quadrant reference
  forresterUrl   String?
  idc            String?

  // ── Press / news ──────────────────────────────────────────────────────────
  // Stored as JSON array: [{title, url, date, source}]
  recentNews     String?

  // ── Customer evidence ─────────────────────────────────────────────────────
  caseStudyUrl   String?
  keyCustomers   String?  // notable logos (comma-separated)
  testimonialsUrl String?

  // ── Computed / notes ─────────────────────────────────────────────────────
  productRepScore Float?   // weighted review score 0–10 (cached)
  researchNotes  String?
  lastResearched DateTime?
  updatedAt      DateTime @updatedAt
}

model HuntSession {
  id          String   @id @default(cuid())
  type        String   @default("HUNT")
  query       String
  results     String   // JSON: HuntResult[] or ScoutResult[]
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())
}
